{
  "name": "gpt-image-playground",
  "private": true,
  "version": "0.6.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:media": "env -u http_proxy -u https_proxy uv run --with-requirements requirements.txt --directory speech-worker uvicorn dev_tts_api:app --host 127.0.0.1 --port 8081",
    "dev:voice": "npm run dev:media",
    "mock:api": "node scripts/mock-image-api.mjs",
    "build": "tsc -b && vite build",
    "deploy:cf": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:ui": "vitest run tests/ui",
    "test:e2e": "playwright test",
    "test:ci": "npm run build && npm test && npm run test:e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imgly/background-removal": "^1.7.0",
    "@paper-design/shaders": "^0.0.69",
    "@streamdown/math": "^1.0.2",
    "@xyflow/react": "^12.11.2",
    "@xzdarcy/react-timeline-editor": "^1.0.0",
    "animejs": "^4.5.0",
    "core-js": "^3.49.0",
    "fflate": "^0.8.2",
    "katex": "^0.16.47",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-filerobot-image-editor": "^5.0.0-beta.159",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0",
    "dompurify": "^3.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.96.0"
  }
}
